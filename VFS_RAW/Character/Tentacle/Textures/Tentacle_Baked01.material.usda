#usda 1.0
(
    "Exported from Adobe Substance 3D Painter 11.0.1"
    defaultPrim = "Tentacle_Group_Rig"
)

def "Tentacle_Group_Rig"
{
    def Scope "material"
    {
        def Material "standardSurface1" (
            customData = {
                dictionary adobe = {
                    dictionary painter = {
                        asset painterProject_spp = @H:/SweetSpot/Painter/Tentacle/Tentacle_Baked01.spp@
                    }
                }
            }
        )
        {
            asset inputs:basecolor_tex = @Tentacle_Baked01_textures/standardSurface1_BaseColorOpacity.png@
            asset inputs:compositedNormalDX_tex = @Tentacle_Baked01_textures/standardSurface1_NormalDX.png@
            asset inputs:emissive_tex = @Tentacle_Baked01_textures/standardSurface1_MetalHeightEmissiveRough.png@
            asset inputs:height_tex = @Tentacle_Baked01_textures/standardSurface1_MetalHeightEmissiveRough.png@
            asset inputs:metallic_tex = @Tentacle_Baked01_textures/standardSurface1_MetalHeightEmissiveRough.png@
            asset inputs:opacity_tex = @Tentacle_Baked01_textures/standardSurface1_BaseColorOpacity.png@
            asset inputs:roughness_tex = @Tentacle_Baked01_textures/standardSurface1_MetalHeightEmissiveRough.png@
            token outputs:adobe:surface.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/AdobeStandardMaterial_4_0Shader.outputs:surface>
            token outputs:displacement.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/UsdPreviewSurfaceShader.outputs:displacement>
            token outputs:surface.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/UsdPreviewSurfaceShader.outputs:surface>

            def NodeGraph "UsdPreviewSurface"
            {
                def Shader "UsdPreviewSurfaceShader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    float3 inputs:diffuseColor.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/diffuseColorTextureShader.outputs:rgb>
                    float3 inputs:emissiveColor.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/emissiveColorTextureShader.outputs:b>
                    float inputs:ior = 1.5
                    float inputs:metallic.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/metallicTextureShader.outputs:r>
                    normal3f inputs:normal.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/normalTextureShader.outputs:rgb>
                    float inputs:roughness.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/roughnessTextureShader.outputs:a>
                    token outputs:displacement
                    token outputs:surface
                }

                def Shader "TexCoordReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "diffuseColorTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:basecolor_tex>
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "roughnessTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:roughness_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:a
                }

                def Shader "metallicTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:metallic_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "emissiveColorTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:emissive_tex>
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:b
                }

                def Shader "normalTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, 1, -1, 0)
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:compositedNormalDX_tex>
                    float4 inputs:scale = (2, -2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/UsdPreviewSurface/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }
            }

            def NodeGraph "AdobeStandardMaterial_4_0"
            {
                def Shader "AdobeStandardMaterial_4_0Shader"
                {
                    uniform token info:id = "AdobeStandardMaterial_4_0"
                    float3 inputs:baseColor.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/baseColorTextureShader.outputs:rgb>
                    float3 inputs:emissive.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/emissiveTextureShader.outputs:b>
                    float inputs:emissiveIntensity = 1
                    float inputs:IOR = 1.5
                    float inputs:metallic.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/metallicTextureShader.outputs:r>
                    normal3f inputs:normal.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/normalTextureShader.outputs:rgb>
                    float inputs:roughness.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/roughnessTextureShader.outputs:a>
                    token outputs:surface
                }

                def Shader "TexCoordReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "baseColorTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:basecolor_tex>
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "roughnessTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:roughness_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:a
                }

                def Shader "metallicTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:metallic_tex>
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normalTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, 1, -1, 0)
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:compositedNormalDX_tex>
                    float4 inputs:scale = (2, -2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }

                def Shader "emissiveTextureShader"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file.connect = </Tentacle_Group_Rig/material/standardSurface1.inputs:emissive_tex>
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Tentacle_Group_Rig/material/standardSurface1/AdobeStandardMaterial_4_0/TexCoordReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:b
                }
            }
        }
    }

    over "Tentacle"
    {
        over "Tentacle" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Tentacle_Group_Rig/material/standardSurface1>
        }
    }
}

